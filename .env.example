# DocuDiff AI Environment Configuration

# AI Provider Configuration ('deterministic', 'gemini', or 'qwen')
DOCUDIFF_LLM_PROVIDER=deterministic

# Optional: Gemini API Key for hosted high-quality explanations
GEMINI_API_KEY=

# Optional: Local HuggingFace Qwen Model Path or identifier
QWEN_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# Pipeline Defaults
DEFAULT_THRESHOLD=0.65
USE_LANGGRAPH=true

